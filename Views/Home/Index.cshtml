@{
    ViewData["Title"] = "Welcome";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Welcome to ABC Retail</h1>
        <p class="text-muted">Select how you want to log in</p>
    </div>

    <div class="row g-4 justify-content-center">

        <!-- Admin Login -->
        <div class="col-md-3">
            <div class="card shadow-sm h-100 text-center border-0">
                <div class="card-body">
                    <i class="bi bi-shield-lock display-3 text-primary mb-3"></i>
                    <h4 class="card-title fw-bold">Admin</h4>
                    <p class="text-muted">Access admin dashboard</p>
                    <a asp-controller="Account" asp-action="Login" asp-route-role="Admin" class="btn btn-primary">Login as Admin</a>
                </div>
            </div>
        </div>

        <!-- Customer Login -->
        <div class="col-md-3">
            <div class="card shadow-sm h-100 text-center border-0">
                <div class="card-body">
                    <i class="bi bi-person-circle display-3 text-success mb-3"></i>
                    <h4 class="card-title fw-bold">Customer</h4>
                    <p class="text-muted">Browse products and manage your cart</p>
                    <a asp-controller="Account" asp-action="Login" asp-route-role="Customer" class="btn btn-success">Login as Customer</a>
                </div>
            </div>
        </div>

    </div>
</div>
