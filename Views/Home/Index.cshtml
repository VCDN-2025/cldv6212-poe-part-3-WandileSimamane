@{
    ViewData["Title"] = "Home";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0"><i class="bi bi-house-door"></i> Dashboard</h4>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-box-seam"></i> Manage Products</h5>
                                        <a asp-controller="Product" asp-action="Index" class="btn btn-primary w-100">Go</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-cart-check"></i> View Orders</h5>
                                        <a asp-controller="Order" asp-action="Index" class="btn btn-primary w-100">Go</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-people"></i> Manage Customers</h5>
                                        <a asp-controller="Customer" asp-action="Index" class="btn btn-primary w-100">Go</a>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (Context.Session.GetString("UserRole") == "Customer")
                        {
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-shop"></i> Shop Now</h5>
                                        <a asp-controller="Product" asp-action="Shop" class="btn btn-success w-100">Browse</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-cart"></i> My Cart</h5>
                                        <a asp-controller="Cart" asp-action="ViewCart" class="btn btn-warning w-100">View</a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="card text-center h-100">
                                    <div class="card-body">
                                        <h5 class="card-title"><i class="bi bi-receipt"></i> My Orders</h5>
                                        <a asp-controller="Order" asp-action="MyOrders" class="btn btn-info w-100">View</a>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-12 text-center py-5">
                                <h3>Welcome! Please <a asp-controller="Account" asp-action="Login">login</a> or <a asp-controller="Account" asp-action="Register">register</a>.</h3>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>