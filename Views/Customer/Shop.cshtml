@model IEnumerable<OrderSystem.Models.Product>

@{
    ViewData["Title"] = "Shop";
}

<div class="container py-4">
    <h2 class="fw-bold mb-4">Shop Products</h2>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-md-3">
                <div class="card h-100 shadow-sm">
                    <img src="@product.ProductImage" class="card-img-top" alt="@product.ProductName" style="height:200px; object-fit:cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.ProductName</h5>
                        <p class="card-text">@product.ProductDetails</p>
                        <p class="card-text fw-bold">@product.Price.ToString("C")</p>
                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@product.RowKey" class="btn btn-success mt-auto">
                            <i class="bi bi-cart-plus"></i> Add to Cart
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
