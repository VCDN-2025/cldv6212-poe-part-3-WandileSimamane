@model IEnumerable<OrderSystem.Services.Shared.Models.CartItem>
@{
    ViewData["Title"] = "Your Cart";
}
<div class="container py-4">
    <div class="row">
        <div class="col-md-8">
            <h2><i class="bi bi-cart"></i> Your Cart</h2>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    Your cart is empty. <a asp-controller="Product" asp-action="Shop">Continue Shopping</a>
                </div>
            }
            else
            {
                <form asp-action="UpdateCart" method="post">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Image</th>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ProductImage))
                                        {
                                            <img src="@item.ProductImage" alt="@item.ProductName" class="img-thumbnail" style="width:60px; height:60px; object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No image</span>
                                        }
                                    </td>
                                    <td><strong>@item.ProductName</strong></td>
                                    <td>R @item.Price.ToString("F2")</td>
                                    <td>
                                        <input type="number" name="quantities[@item.RowKey]" value="@item.Quantity" min="0" class="form-control w-50" />
                                    </td>
                                    <td>R @(item.Price* item.Quantity).ToString("F2")</td>
                                    <td>
                                        <a asp-action="RemoveItem" asp-route-cartItemId="@item.RowKey" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button type="submit" class="btn btn-primary">Update Cart</button>
                </form>
            }
        </div>

        <div class="col-md-4">
            @if (Model.Any())
            {
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h5>Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Total Items:</strong> @Model.Sum(i => i.Quantity)</p>
                        <h4><strong>Total: R @Model.Sum(i => i.Price * i.Quantity).ToString("F2")</strong></h4>
                        <a asp-action="Checkout" class="btn btn-success w-100 mt-3">
                            <i class="bi bi-check-circle"></i> Proceed to Checkout
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>