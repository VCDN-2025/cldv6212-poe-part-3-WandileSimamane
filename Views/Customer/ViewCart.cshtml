@model List<OrderSystem.Services.Shared.Models.CartItem>

@{
    ViewData["Title"] = "Your Cart";
}

<h2>Your Cart</h2>

@if (Model == null || !Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <form asp-action="UpdateQuantity" method="post">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductId</td> 
                        <td>
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" />
                            <input type="hidden" name="cartItemId" value="@item.RowKey" />
                        </td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@(item.Quantity* item.Price).ToString("C")</td>
                        <td>
                            <a asp-action="RemoveItem" asp-route-cartItemId="@item.RowKey" class="btn btn-danger btn-sm">Remove</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Update Quantities</button>
    </form>

    <div class="mt-3">
        <p><strong>Total:</strong> @Model.Sum(i => i.Quantity * i.Price).ToString("C")</p>
        <a asp-action="Checkout" class="btn btn-success">Checkout</a>
    </div>
}
