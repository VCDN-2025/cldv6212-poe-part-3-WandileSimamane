@model OrderSystem.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-person-circle"></i> Customer Details</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.CustomerName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomerName)</dd>

                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.CustomerEmail)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomerEmail)</dd>
            </dl>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model?.RowKey" class="btn btn-warning">
                    <i class="bi bi-pencil-square"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left-circle"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
