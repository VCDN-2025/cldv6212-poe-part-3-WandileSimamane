@model OrderSystem.Services.Shared.Models.Customer
@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container py-4">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-trash"></i> Delete Customer</h4>
        </div>
        <div class="card-body">
            <h5 class="text-danger">Are you sure you want to delete this customer?</h5>
            <hr />
            <dl class="row">
                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.CustomerName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomerName)</dd>

                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.CustomerEmail)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomerEmail)</dd>
            </dl>

            <form asp-action="Delete" class="mt-3">
                <input type="hidden" asp-for="RowKey" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
