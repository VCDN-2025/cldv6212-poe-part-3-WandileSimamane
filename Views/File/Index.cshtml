@{
    ViewData["Title"] = "Upload Contracts";
}

<div class="container py-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-upload"></i> Upload Dummy Contracts</h4>
        </div>
        <div class="card-body">
            <form asp-controller="File" asp-action="Upload" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="file" class="form-label">Select a file:</label>
                    <input type="file" name="file" id="file" class="form-control" />
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-cloud-arrow-up"></i> Upload File
                </button>
                <a asp-action="Index" asp-controller="Home" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left-circle"></i> Back to Dashboard
                </a>
            </form>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-info mt-3">
                    @ViewBag.Message
                </div>
            }
        </div>
    </div>
</div>
