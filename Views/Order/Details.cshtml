@model OrderSystem.Models.Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-receipt"></i> Order Details</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.ProductId)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ProductId)</dd>

                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.CustomerId)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.CustomerId)</dd>
            </dl>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model?.RowKey" class="btn btn-warning">
                    <i class="bi bi-pencil-square"></i> Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary ms-2">
                    <i class="bi bi-arrow-left-circle"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
