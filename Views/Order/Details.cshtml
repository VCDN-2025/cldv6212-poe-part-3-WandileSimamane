@model OrderSystem.Models.Order
@{
    ViewData["Title"] = "Order Details";
    var items = ViewBag.OrderItems as List<dynamic>;
}

<h2>Order Details</h2>

<p><strong>Order ID:</strong> @Model.RowKey</p>
<p><strong>Order Date:</strong> @Model.OrderDate.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</p>

<h3>Products</h3>
@if (items == null || !items.Any())
{
    <p>No products found in this order.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in items)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td>@item.Quantity</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-secondary">Back to Orders</a>
