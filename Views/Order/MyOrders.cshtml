@model IEnumerable<OrderSystem.Services.Shared.Models.Order>
@{
    ViewData["Title"] = "My Orders";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0"><i class="bi bi-receipt"></i> My Orders</h4>
                </div>

                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="p-4 text-center text-muted">You have no orders yet.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>ID</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Total</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><strong>@item.RowKey</strong></td>
                                            <td>@item.OrderDate.LocalDateTime:dd/MM/yyyy HH:mm</td>
                                            <td>
                                                <span class="badge @(item.Status == "Completed" ? "bg-success" :
                                                                                                                         item.Status == "Cancelled" ? "bg-danger" : "bg-warning")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>@item.TotalAmount.ToString("C")</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.RowKey" class="btn btn-sm btn-primary">Details</a>
                                    </td>
                                </tr>
                                                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>