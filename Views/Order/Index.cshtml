@model List<OrderSystem.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<h2>My Orders</h2>

@if (!Model.Any())
{
    <p>You have no orders yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Products</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.RowKey</td>
                    <td>@order.OrderDate.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@order.ProductId</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.RowKey" class="btn btn-sm btn-primary">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
