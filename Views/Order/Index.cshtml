@using OrderSystem.Services.Shared.Models
@model IEnumerable<Order>
@{
    ViewData["Title"] = "All Orders";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">

                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-list-ul"></i> All Orders</h4>
                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Create Manual Order
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Any())
                    {
                        <div class="p-4 text-center text-muted">No orders found.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Customer</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                        <th>Total</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model)
                                    {
                                        <tr>
                                            <td><strong>@order.RowKey</strong></td>
                                            <td>@order.CustomerEmail</td>
                                            <td>@order.OrderDate.LocalDateTime:dd/MM/yyyy HH:mm</td>
                                            <td>
                                                <form asp-action="UpdateStatus" asp-route-id="@order.RowKey" method="post" class="d-inline">
                                                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                                        <option value="Pending" selected="@(order.Status == "Pending")">Pending</option>
                                                        <option value="Completed" selected="@(order.Status == "Completed")">Completed</option>
                                                        <option value="Cancelled" selected="@(order.Status == "Cancelled")">Cancelled</option>
                                                    </select>
                                                </form>
                                            </td>
                                            <td>@order.TotalAmount.ToString("C")</td>
                                            <td class="text-end">
                                                <a asp-action="Details" asp-route-id="@order.RowKey" class="btn btn-sm btn-info me-1">Details</a>
                                                <a asp-action="Edit" asp-route-id="@order.RowKey" class="btn btn-sm btn-warning me-1">Edit</a>
                                                <a asp-action="Delete" asp-route-id="@order.RowKey" class="btn btn-sm btn-danger">Delete</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>