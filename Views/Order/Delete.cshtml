@using OrderSystem.Services.Shared.Models
@model Order
@{
    ViewData["Title"] = "Delete Order";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-trash"></i> Delete Order</h4>
                </div>
                <div class="card-body">
                    <h5 class="text-danger">Are you sure you want to delete this order?</h5>
                    <hr />

                    <dl class="row mb-3">
                        <dt class="col-sm-3">Order ID</dt>
                        <dd class="col-sm-9"><strong>@Model.RowKey</strong></dd>

                        <dt class="col-sm-3">Customer</dt>
                        <dd class="col-sm-9">@Model.CustomerEmail</dd>

                        <dt class="col-sm-3">Total</dt>
                        <dd class="col-sm-9">@Model.TotalAmount.ToString("C")</dd>
                    </dl>

                    <h6>Items in this order:</h6>
                    @if (!Model.Items.Any())
                    {
                        <p class="text-muted">No items.</p>
                    }
                    else
                    {
                        <ul class="list-group mb-3">
                            @foreach (var item in Model.Items)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@item.ProductName × @item.Quantity</span>
                                    <span>@(item.Quantity* item.Price).ToString("C")</span>
                                </li>
                            }
                        </ul>
                    }

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="RowKey" />
                        <button type="submit" class="btn btn-danger w-100">
                            Confirm Delete
                        </button>

                        <div class="mt-2 text-center">
                            <a asp-action="Index" class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>