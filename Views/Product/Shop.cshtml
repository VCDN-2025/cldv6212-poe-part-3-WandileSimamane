@model IEnumerable<OrderSystem.Services.Shared.Models.Product>
@{
    ViewData["Title"] = "Shop";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-shop"></i> Shop Products</h4>
                </div>

                <div class="card-body">
                    <div class="row g-4">
                        @foreach (var item in Model)
                        {
                            <div class="col-md-3">
                                <div class="card h-100 shadow-sm">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="@item.ProductImage" class="card-img-top" alt="@item.ProductName" style="height:200px; object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light text-center py-5" style="height:200px;">
                                            <i class="bi bi-image fs-1 text-muted"></i>
                                        </div>
                                    }
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">@item.ProductName</h5>
                                        <p class="card-text flex-grow-1">@item.ProductDetails</p>
                                        <p class="card-text fw-bold">@item.Price.ToString("C")</p>
                                        <p class="text-muted small">Stock: @item.Stock</p>

                                        <form asp-controller="Cart" asp-action="AddItem" method="post" class="mt-auto">
                                            <input type="hidden" name="productId" value="@item.RowKey" />
                                            <button type="submit" class="btn btn-success w-100">
                                                <i class="bi bi-cart-plus"></i> Add to Cart
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>