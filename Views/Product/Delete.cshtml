@model OrderSystem.Services.Shared.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-trash"></i> Delete Product</h4>
                </div>
                <div class="card-body">
                    <h5 class="text-danger">Are you sure you want to delete this product?</h5>
                    <hr />

                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(m => m.ProductName)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(m => m.ProductName)</dd>

                        <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(m => m.ProductDetails)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(m => m.ProductDetails)</dd>

                        <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(m => m.Price)</dt>
                        <dd class="col-sm-9">@Model.Price.ToString("C")</dd>

                        <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(m => m.Stock)</dt>
                        <dd class="col-sm-9">@Model.Stock</dd>

                        <dt class="col-sm-3 fw-bold">Image</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.ProductImage))
                            {
                                <img src="@Model.ProductImage" alt="Product Image" class="img-thumbnail" style="max-width:150px; height:auto;" />
                            }
                            else
                            {
                                <em>No image</em>
                            }
                        </dd>
                    </dl>

                    <form asp-action="Delete" class="mt-3">
                        <input type="hidden" asp-for="RowKey" />
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-trash"></i> Confirm Delete
                        </button>

                        <div class="mt-2 text-center">
                            <a asp-action="Index" class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>