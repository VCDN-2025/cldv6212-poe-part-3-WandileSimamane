@model OrderSystem.Services.Shared.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container py-4">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0"><i class="bi bi-trash"></i> Delete Product</h4>
        </div>
        <div class="card-body">
            <h5 class="text-danger">Are you sure you want to delete this product?</h5>
            <hr />
            <dl class="row">
                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.ProductName)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ProductName)</dd>

                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.ProductDetails)</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.ProductDetails)</dd>

                <dt class="col-sm-3 fw-bold">@Html.DisplayNameFor(model => model.ProductImage)</dt>
                <dd class="col-sm-9">
                    <img src="@Model.ProductImage" alt="Product Image" class="img-thumbnail" style="max-width: 150px; height:auto;" />
                </dd>
            </dl>

            <form asp-action="Delete" class="mt-3">
                <input type="hidden" asp-for="RowKey" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Confirm Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
