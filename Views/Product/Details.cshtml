@model OrderSystem.Services.Shared.Models.Product
@{
    ViewData["Title"] = Model.ProductName;
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-5">
                            @if (!string.IsNullOrEmpty(Model.ProductImage))
                            {
                                <img src="@Model.ProductImage" class="img-fluid rounded" alt="@Model.ProductName" />
                            }
                            else
                            {
                                <div class="bg-light border rounded d-flex align-items-center justify-content-center" style="height: 300px;">
                                    <span class="text-muted">No image</span>
                                </div>
                            }
                        </div>
                        <div class="col-md-7">
                            <h2 class="mb-3">@Model.ProductName</h2>
                            <p class="text-muted mb-3">@Model.ProductDetails</p>
                            <h4 class="text-success mb-3">R @Model.Price.ToString("F2")</h4>
                            <p class="mb-3"><strong>Stock:</strong> @Model.Stock available</p>

                            @if (Model.Stock > 0)
                            {
                                <form asp-action="Details" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.RowKey" />
                                    <div class="input-group w-auto d-inline-flex align-items-center">
                                        <label class="me-2"><strong>Qty:</strong></label>
                                        <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control w-25" />
                                        <button type="submit" class="btn btn-primary ms-2">
                                            <i class="bi bi-cart-plus"></i> Add to Cart
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }

                            <div class="mt-3">
                                <a asp-controller="Product" asp-action="Shop" class="btn btn-secondary">
                                    <i class="bi bi-arrow-left"></i> Back to Shop
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>